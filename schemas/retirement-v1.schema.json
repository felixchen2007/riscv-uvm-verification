{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-hart RV32I architectural retirement trace v1",
  "type": "object",
  "required": ["schema_version", "processor_config", "producer", "isa", "complete", "program_sha256", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "processor_config": {"type": "string"},
    "program_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "producer": {"enum": ["dut", "spike"]},
    "isa": {"const": "rv32i"},
    "complete": {"const": true},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["order", "hart", "pc", "insn", "rd_address", "rd_data", "trap", "halt", "interrupt", "memory"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "native_order": {"type": "integer", "minimum": 0},
        "hart": {"const": 0},
        "pc": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "insn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "rd_address": {"type": "integer", "minimum": 0, "maximum": 31},
        "rd_data": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "trap": {"type": "boolean"}, "halt": {"type": "boolean"}, "interrupt": {"type": "boolean"},
        "memory": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["kind", "address", "data", "mask"],
          "properties": {"kind": {"enum": ["load", "store"]},
            "address": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "data": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "mask": {"type": "integer", "minimum": 1, "maximum": 15}}}]}
      }
    }}
  }
}
